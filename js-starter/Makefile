.PHONY: install dev-install run serve test test-coverage lint format format-check audit build clean

install:
	npm ci

dev-install:
	npm install

run:
	npm run start

serve:
	npm run serve

test:
	npm test

test-coverage:
	npm run test:coverage

lint:
	npm run lint

format:
	npm run format

format-check:
	npm run format:check

audit:
	npm audit --audit-level=moderate

build:
	npm run build

clean:
	npm run clean
