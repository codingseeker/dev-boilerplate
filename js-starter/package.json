{
  "name": "js-starter",
  "version": "1.0.0",
  "description": "Production-grade JavaScript CLI-first modular boilerplate",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "app": "./src/cli/index.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "cli": "node src/cli/index.js",
    "serve": "node src/main.js --serve",
    "test": "node --test",
    "test:coverage": "c8 --reporter=text --reporter=lcov node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "echo 'No build step required for ES modules'",
    "clean": "rm -rf coverage .nyc_output dist"
  },
  "keywords": [
    "cli",
    "boilerplate",
    "fastify",
    "modular"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "c8": "^10.1.3",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2"
  }
}
