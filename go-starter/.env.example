# Copy to .env and adjust for local development. The file is optional: the
# application falls back to the documented defaults when it is absent, and it is
# never loaded while APP_ENV is production.

# Application identity
APP_NAME=go-starter
# development | testing | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# HTTP server
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=30s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=30s
